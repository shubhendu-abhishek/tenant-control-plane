# Local development defaults; docker-compose uses these when present.
POSTGRES_DB=controlplane
POSTGRES_USER=controlplane
POSTGRES_PASSWORD=local-dev-only-change-me
RABBITMQ_USER=controlplane
RABBITMQ_PASSWORD=local-dev-only-change-me
DATABASE_URL=postgres://controlplane:local-dev-only-change-me@postgres:5432/controlplane?sslmode=disable
AMQP_URL=amqp://controlplane:local-dev-only-change-me@rabbitmq:5672/
HTTP_ADDR=:8080
WORKER_FAIL_RATE=0
WORKER_MIN_DELAY_MS=500
WORKER_MAX_DELAY_MS=2500
